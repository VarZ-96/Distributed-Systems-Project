# =============================================================================
# Backend Environment Configuration (Copy to .env and fill in real values)
# NEVER commit .env to version control!
# =============================================================================

NODE_ENV=development
PORT=4000

# Frontend URL (used for strict CORS and post-login redirect)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection (matches root docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oauth_rbac_demo

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Local Identity-Only JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-minimum-32-character-cryptographically-random-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=oauth-rbac-demo
JWT_AUDIENCE=oauth-rbac-demo-client

# Comma-separated emails automatically granted the 'admin' role on Google login
ADMIN_EMAILS=your-admin-email@gmail.com
